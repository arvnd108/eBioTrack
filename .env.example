# Owner: A (Backend)
# Purpose: Template for local environment variables. Copy to .env (git-ignored); never commit real secrets.
DATABASE_URL=postgres://ebiotrack:change_me@localhost:5432/ebiotrack
TEST_DATABASE_URL=postgres://ebiotrack:change_me@localhost:5432/ebiotrack_test
SESSION_SECRET=change_me
PORT=4000
NODE_ENV=development
# Optional: maximum connections in the pool (default 10)
# DB_POOL_MAX=10
# Optional: session lifetime in hours (default 8)
# SESSION_MAX_AGE_HOURS=8
# Optional: force the session cookie Secure flag (default: true only in production)
# COOKIE_SECURE=false
# Optional: comma-separated browser origins allowed to send state-changing requests
# (default: http://localhost:5173 outside production, none in production = same origin only)
# ALLOWED_ORIGINS=http://localhost:5173
