{
  "name": "ebiotrack-tests",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run --config vitest.config.js",
    "test:smoke": "vitest run --config vitest.config.js smoke/",
    "test:integrity": "vitest run --config vitest.config.js integrity/",
    "test:queries": "vitest run --config vitest.config.js queries/",
    "test:transactions": "vitest run --config vitest.config.js transactions/",
    "test:concurrency": "vitest run --config vitest.config.js concurrency/",
    "test:authorization": "vitest run --config vitest.config.js authorization/",
    "test:recovery": "vitest run --config vitest.config.js recovery/",
    "lint": "eslint .",
    "format": "prettier --check .",
    "volume:load": "node fixtures/generate-volume-data.js",
    "volume:clean": "node fixtures/generate-volume-data.js --clean"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "dotenv": "^18.0.9",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "vitest": "^5.0.5"
  }
}
